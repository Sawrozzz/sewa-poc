{
  "name": "@sewa/platform-contracts",
  "version": "1.0.0",
  "description": "Shared platform contracts — events, messages, module manifests, SDK interfaces",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.mjs",
      "require": "./dist/events.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.mjs",
      "require": "./dist/transport.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/events.ts src/transport.ts src/bridge.ts src/browser-bridge.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/events.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@sewa/event-bus": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
