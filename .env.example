SDK_CDN_URL=https://cdn.jsdelivr.net/gh/lizuzsusil/mini-app-sdk@v1.1.0/mini-app-sdk.min.js
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000/api/auth

# OAuth2 — set these to point at your external auth server
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Use discovery URL OR individual endpoints:
OAUTH2_DISCOVERY_URL=
OAUTH2_AUTH_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_SCOPES=openid,profile,email
NEXT_PUBLIC_OAUTH2_PROVIDER_NAME=OAuth2

NEXT_PUBLIC_MAX_CACHED_MINI_APPS=2

NEXT_PUBLIC_SDK_NAME=@lizuz/sewa-sdk

NEXT_PUBLIC_SDK_VERSION=1.0.7

# NEXT_PUBLIC_SDK_CACHE=off

# NEXT_PUBLIC_SDK_URL_TEMPLATE=/sdk/sewa-sdk.min.js
# --- Signed mini-app manifest -------------------------------------------------
# PEM of the registry's manifest-signing public key. Leave unset to use the key
# compiled into src/lib/manifest-signature.ts. Escaped \n newlines are accepted.
# NEXT_PUBLIC_MANIFEST_PUBLIC_KEY=

# Set to "false" to render the manifest even when its signature does not verify
# (the failure is still logged). Any other value — or unset — blocks it.
# NEXT_PUBLIC_MANIFEST_SIGNATURE_REQUIRED=false



NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
