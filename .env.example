SDK_CDN_URL=https://cdn.jsdelivr.net/gh/lizuzsusil/mini-app-sdk@v1.1.0/mini-app-sdk.min.js
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000/api/auth

# OAuth2 — set these to point at your external auth server
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Use discovery URL OR individual endpoints:
OAUTH2_DISCOVERY_URL=
OAUTH2_AUTH_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_SCOPES=openid,profile,email
NEXT_PUBLIC_OAUTH2_PROVIDER_NAME=OAuth2