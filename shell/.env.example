# Mini-app SDK CDN source
SDK_CDN_URL=https://cdn.jsdelivr.net/npm/@sawrozzz/sdk-revised@1.1.2/dist/sdk-revised.min.js
# Auth server config
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000/api/auth
# Number of mini-app bundles kept in the PWA asset cache (FIFO eviction).
# When exceeded, the oldest cached app's assets are removed from IndexedDB.
NEXT_PUBLIC_MAX_CACHED_MINI_APPS=2
