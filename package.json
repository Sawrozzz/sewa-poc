{
  "name": "sewa-app",
  "private": true,
  "version": "1.0.0",
  "description": "Government Shell App",
  "workspaces": [
    "packages/*",
    "shell"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "turbo": "^2.9.18"
  },
  "scripts": {
    "build:turbo": "turbo run build",
    "build:platform": "pnpm --filter @sewa/host-platform build && pnpm --filter @sewa/runtime-loader build",
    "build": "pnpm build:platform && pnpm --filter @sewa/shell build",
    "dev": "pnpm link:env && pnpm --filter @sewa/shell dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "clean": "turbo run clean",
    "link:env": "ln -s ../.env shell/.env"
  },
  "packageManager": "pnpm@11.9.0"
}
