{
  "name": "sewa-app",
  "private": true,
  "version": "1.0.0",
  "description": "Government Shell App",
  "workspaces": [
    "packages/*",
    "shell"
  ],
  "devDependencies": {
    "lerna": "^9.0.7",
    "turbo": "^2.9.18"
  },
  "scripts": {
    "build:turbo": "turbo run build",
    "build:platform": "pnpm --filter @sewa/host-platform build && pnpm --filter @sewa/runtime-loader build",
    "build": "pnpm build:platform && pnpm --filter @sewa/shell-app build",
    "dev": "pnpm --filter @sewa/shell-app dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "link:env": "ln -s ../.env shell/.env",
    "lerna": "lerna",
    "version": "lerna version",
    "publish:packages": "lerna publish from-package"
  },
  "packageManager": "pnpm@11.9.0"
}
